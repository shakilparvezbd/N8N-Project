            "index": 0
          }
        ]
      ]
    },
    "Fetch Existing WP Posts": {
      "main": [
        [
          {
            "node": "Prepare AI Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare AI Input": {
      "main": [
        [
          {
            "node": "Fetch WP Categories",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch WP Categories": {
      "main": [
        [
          {
            "node": "Merge Categories",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Categories": {
      "main": [
        [
          {
            "node": "OpenRouter AI - Generate Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenRouter AI - Generate Content": {
      "main": [
        [
          {
            "node": "Parse AI Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse AI Response": {
      "main": [
        [
          {
            "node": "Check No Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check No Error": {
      "main": [
        [
          {
            "node": "Publish to WordPress",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to WordPress": {
      "main": [
        [
          {
            "node": "Prepare Sheet Update",
