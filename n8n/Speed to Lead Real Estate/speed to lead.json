    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers || {};\nconst query = item.query || {};\nconst rawBody = item.body && typeof item.body === 'object' ? item.body : {};\n\n// Supports both a flat body and a nested \"lead\" object\nconst body = rawBody.lead && typeof rawBody.lead === 'object' ? { ...rawBody, ...rawBody.lead } : rawBody;\n\nconst str = (v) => {\n  if (v === undefined || v === null) return '';\n  if (typeof v === 'object') return ''; // Prevents [object Object] issue safely\n  return String(v).replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]/g, '').trim();\n};\nconst pick = (...keys) => { for (const k of keys) { const v = str(body[k]); if (v) return v; } return ''; };\n\n// Escape text for Telegram HTML parse mode\nconst esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// ---- Authentication ----\n// Configure a unique secret before enabling authentication.\nconst REQUIRE_AUTH = false;\nconst WEBHOOK_SECRET = '';\nconst givenSecret = str(headers['x-webhook-secret'] || query.secret);\nconst authorized = REQUIRE_AUTH ? Boolean(WEBHOOK_SECRET) && givenSecret === WEBHOOK_SECRET : true;\n\n// ---- Normalize fields ----\nconst first = pick('first_name', 'firstName', 'firstname');\nconst last = pick('last_name', 'lastName', 'lastname');\nconst rawName = pick('full_name', 'fullName', 'name') || [first, last].filter(Boolean).join(' ');\nconst name = (typeof rawName === 'string' && rawName.trim() ? rawName : 'Unknown').slice(0, 120);\n\nconst emailCandidate = pick('email', 'email_address', 'emailAddress').toLowerCase();\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(emailCandidate) && emailCandidate.length <= 254;\nconst email = emailOk ? emailCandidate : '';\n\nconst rawPhone = pick('phone', 'phone_number', 'phoneNumber', 'mobile', 'cell');\nconst digits = rawPhone.replace(/[^\\d]/g, '');\nlet phoneCandidate = '';\nif (rawPhone.startsWith('+')) phoneCandidate = '+' + digits;\nelse if (digits.length === 10) phoneCandidate = '+1' + digits;\nelse if (digits.length === 11 && digits.startsWith('1')) phoneCandidate = '+' + digits;\nconst phoneOk = /^\\+[1-9]\\d{7,14}$/.test(phoneCandidate);\nconst phone = phoneOk ? phoneCandidate : '';\n\nconst consentRaw = str(body.sms_consent ?? body.smsConsent ?? body.consent).toLowerCase();\nconst smsConsent = ['true', 'yes', 'y', '1', 'on', 'agree', 'agreed'].includes(consentRaw);\n\nconst source = (pick('source', 'lead_source', 'utm_source', 'platform') || 'unknown').slice(0, 60);\nconst propertyInterest = pick('property', 'listing', 'address', 'property_address').slice(0, 200);\nconst message = pick('message', 'comments', 'comment', 'notes', 'inquiry', 'question').slice(0, 1000);\n\n// ---- Validity: at least one working contact method ----\nconst valid = emailOk || phoneOk;\nconst leadKey = email || phone;\nconst hash = (s) => { let h = 5381; for (let i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0; return h.toString(36); };\nconst leadId = leadKey ? 'L-' + hash(leadKey) : '';\n\n// ---- Timestamps ----\nconst now = new Date();\nlet receivedLocal = now.toISOString();\ntry {\n  receivedLocal = now.toLocaleString('en-US', { timeZone: item.cfg_timezone || 'America/New_York', dateStyle: 'medium', timeStyle: 'short' });\n} catch (e) {}\n\n// ---- De-duplicate repeated submits inside a short window ----\nlet duplicate = false;\nif (authorized && valid) {\n  const store = $getWorkflowStaticData('global');\n  store.recent = store.recent || {};\n  const windowMs = (Number(item.cfg_dedupe_minutes) || 10) * 60000;\n  const t = now.getTime();\n  for (const k of Object.keys(store.recent)) { if (t - store.recent[k] > windowMs) delete store.recent[k]; }\n  if (store.recent[leadKey]) duplicate = true; else store.recent[leadKey] = t;\n}\n\n// ---- Decision ----\nlet reject = false, httpStatus = 200, rejectReason = '', status = 'accepted';\nif (!authorized) { reject = true; httpStatus = 401; rejectReason = 'unauthorized'; status = 'rejected'; }\nelse if (!valid) { reject = true; httpStatus = 400; rejectReason = 'invalid_data'; status = 'rejected'; }\nelse if (duplicate) { status = 'duplicate_ignored'; }\n\n// Carry config forward\nconst cfgOut = {};\nfor (const [k, v] of Object.entries(item)) { if (k.startsWith('cfg_')) cfgOut[k] = v; }\n\nconst rawPayload = rejectReason === 'invalid_data' ? JSON.stringify(rawBody).slice(0, 800) : '';\n\nreturn [{\n  json: {\n    ...cfgOut,\n    reject, http_status: httpStatus, reject_reason: rejectReason, status,\n    process: !reject && !duplicate,\n    lead_id: leadId, name,\n    first_name: name.split(/\\s+/)[0] || 'there',\n    email, phone, has_email: !!email,\n    sms_consent: smsConsent, sms_allowed: !!phone && smsConsent,\n    source, property_interest: propertyInterest, message,\n    received_at_iso: now.toISOString(), received_at_local: receivedLocal,\n    raw_payload: rawPayload,\n    // HTML-safe copies for Telegram messages\n    h_name: esc(name), h_email: esc(email), h_phone: esc(phone), h_source: esc(source),\n    h_property: esc(propertyInterest), h_message: esc(message), h_raw: esc(rawPayload)\n  }\n}];"
      },
