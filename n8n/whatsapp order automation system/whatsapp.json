    {
      "parameters": {
        "jsCode": "// AI-এর আউটপুট ভেরিয়েবল নেওয়া\nlet aiOutput = $input.first().json.output;\n\ntry {\n  // টেক্সটের ভেতর থেকে শুধুমাত্র প্রথম { থেকে শেষ } পর্যন্ত JSON অংশটুকু এক্সট্রাক্ট করা\n  const jsonMatch = aiOutput.match(/\\{[\\s\\S]*\\}/);\n  \n  if (!jsonMatch) {\n    throw new Error(\"No JSON found in output\");\n  }\n\n  // এক্সট্রাক্ট করা স্ট্রিংকে JSON অবজেক্টে রূপান্তর করা\n  const parsedData = JSON.parse(jsonMatch[0]);\n\n  // সফলভাবে পার্স হলে Google Sheets-এর জন্য ডেটা রিটার্ন করা\n  return [{ json: parsedData }];\n  \n} catch (error) {\n  // যদি কোনো কারণে ফেইল করে, এরর লগ রিটার্ন করা যাতে ওয়ার্কফ্লো ক্র্যাশ না করে\n  return [{ json: { error: \"JSON Parse Failed\", raw_data: aiOutput } }];\n}"
      },
